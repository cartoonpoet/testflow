{
  "name": "@testflow/db",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test": "vitest run --passWithNoTests",
    "clean": "rm -rf dist .turbo *.tsbuildinfo",
    "migration:run": "node --env-file-if-exists=../../.env dist/cli/migration-run.js",
    "migration:revert": "node --env-file-if-exists=../../.env dist/cli/migration-revert.js",
    "migration:show": "node --env-file-if-exists=../../.env dist/cli/migration-show.js"
  },
  "dependencies": {
    "@testflow/contracts": "workspace:*",
    "mysql2": "3.24.4",
    "reflect-metadata": "0.2.2",
    "typeorm": "1.1.1"
  },
  "devDependencies": {
    "@testflow/config-eslint": "workspace:*",
    "@testflow/config-typescript": "workspace:*",
    "@types/node": "22.20.3",
    "eslint": "10.10.0",
    "typescript": "6.0.3",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  }
}
