# TestFlow 환경변수 예시.
# 실제 값은 .env 에 두고 절대 커밋하지 않는다 (CLAUDE.md 보안 수칙).
#   cp .env.example .env

# ── Database (MySQL 8.4) ─────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=root
DB_PW=testflow_local
DB_NAME=testflow

# ── Redis (BullMQ 큐 + 실행 이벤트 pub/sub + 녹화 세션 토큰) ──
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# ── API (NestJS) ─────────────────────────────────────
API_PORT=4000
# 프로덕션에서만 사용. 콤마 구분. 개발에서는 전체 허용.
CORS_ORIGINS=http://localhost:5173

# ── Runner (Playwright 실행 + 녹화 WS 호스트) ──────────
# 녹화 WS 는 API 를 경유하지 않고 Runner 로 직결된다 (nginx 에서 /rec/ 만 프록시).
RUNNER_WS_PORT=4100
# API 가 응답하는 wsUrl 에 넣을 호스트. 테스터 브라우저가 접속할 수 있는 주소여야 한다.
RUNNER_WS_HOST=127.0.0.1
# nginx 뒤에 둘 때만 설정. 비어 있으면 ws://RUNNER_WS_HOST:RUNNER_WS_PORT/rec 를 쓴다.
#   예) RUNNER_WS_PUBLIC_URL=wss://testflow.internal/rec
RUNNER_WS_PUBLIC_URL=
# 실행 라이브 스트림(/live/:runId) 전용. 비어 있으면 ws://RUNNER_WS_HOST:RUNNER_WS_PORT/live 를 쓴다.
#   예) RUNNER_WS_LIVE_PUBLIC_URL=wss://testflow.internal/live
RUNNER_WS_LIVE_PUBLIC_URL=
# 동시 실행 가능한 시나리오 수 (BullMQ Worker concurrency)
RUNNER_CONCURRENCY=2
# health 판정 키(testflow:runner:heartbeat:<id>)에 쓰는 식별자.
# 비우면 <호스트명>-<pid> 로 자동 생성한다. Runner 를 여러 대 띄워도 서로 구분된다.
RUNNER_ID=
# 브라우저를 화면 없이 띄울지. 로컬에서 눈으로 보려면 false.
RUNNER_HEADLESS=true
# 실행 1건의 하드 타임아웃(ms). 넘기면 브라우저를 끊고 status 를 timeout 으로 확정한다.
RUNNER_RUN_TIMEOUT_MS=300000

# ── 녹화 세션 (Runner WS) ─────────────────────────────
# ★ 송출 fps 상한. PoC-1 은 60fps 를 그대로 흘려 세션당 14.6~33.1 Mbps 를 썼다.
#   필요한 건 10fps 이므로 15 로 제한한다 — 실측 대역폭이 9.83 → 2.16 Mbps(약 1/4.5)로 줄고
#   합격 기준(지연 ≤200ms, ≥10fps)은 그대로 유지된다. 0 이하면 제한하지 않는다.
RECORD_MAX_FPS=15
# 마지막 클라이언트 메시지로부터 이 시간이 지나면 브라우저를 폐기하고 status 를 expired 로 바꾼다.
# 초안(draft_steps)은 남긴다 — 테스터가 잠깐 자리를 비운 것뿐일 수 있다.
RECORDING_IDLE_TIMEOUT_MS=300000

# ── 증적(Artifact) 저장소 ─────────────────────────────
# 로컬 디스크 + StorageAdapter 추상화. API 와 Runner 가 같은 호스트에서
# 이 경로를 공유해야 한다 (API 가 증적을 서빙하기 때문).
ARTIFACT_ROOT=./artifacts
# 성공한 실행의 video/trace 도 보관할지 여부. 기본 false (디스크 절약).
KEEP_ARTIFACTS_ON_SUCCESS=false

# ── 실행 격리 ─────────────────────────────────────────
# local  (기본) : 실행마다 새 브라우저 프로세스 + 고유 임시 프로필.
#                 개발 머신·CI 에서 3.5GB 이미지를 전제하지 않는다.
# docker        : 실행 1회당 컨테이너 1개 + --memory/--cpus 커널 수준 제한. 운영 권장.
#                 ★ 컨테이너 안에 들어가는 것은 브라우저뿐이다 — 인터프리터·DB 자격증명·
#                   실행 변수(계정/비밀번호)는 호스트에 남는다(apps/runner/src/execute/container.ts).
#                 ★ 대상 사이트가 호스트 로컬이면 baseUrl 에 127.0.0.1 대신
#                   host.docker.internal 을 써야 컨테이너에서 닿는다.
RUNNER_EXECUTION_MODE=local
# docker 모드 전용. Dockerfile.exec 로 만든 파생 이미지를 쓴다:
#   docker build -f apps/runner/Dockerfile.exec -t testflow/playwright-exec:1.63.0 .
RUNNER_DOCKER_IMAGE=testflow/playwright-exec:1.63.0
RUNNER_CONTAINER_MEMORY=2g
RUNNER_CONTAINER_CPUS=1.5
# WSL + Docker Desktop 에서는 리눅스 `docker` 가 없고 `docker.exe` 만 PATH 에 잡힌다.
# 비우면 docker → docker.exe 순으로 탐색한다.
RUNNER_DOCKER_BIN=

# NOTE: SECRET_ENC_KEY 는 의도적으로 없다.
#       계정/비밀번호는 실행 요청 body 로 받아 큐 페이로드에만 존재하고
#       DB 에 영구 저장하지 않는다. AES-256-GCM 암호화는 MVP 범위 밖이다.
#       (02-context "★ 사용자 최종 결정" (c))

# ── docker-compose 전용 (로컬 컨테이너 기동 값) ────────
# 위의 DB_* / REDIS_* 는 "앱이 접속할 주소"이고,
# 아래 TESTFLOW_* 는 "컨테이너를 어떤 값으로 띄울지"다. 이름을 분리한 이유는
# 개발자 셸의 회사 공용 DB_PW 가 compose 로 새어 들어가는 것을 막기 위해서다.
TESTFLOW_DB_PW=testflow_local
TESTFLOW_DB_NAME=testflow
TESTFLOW_DB_PORT=3307
TESTFLOW_REDIS_PORT=6379
