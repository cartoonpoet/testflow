{
  "name": "@testflow/runner",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "node --watch --enable-source-maps dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.poc.json --noEmit",
    "lint": "eslint src poc",
    "test": "vitest run --passWithNoTests",
    "clean": "rm -rf dist dist-poc .turbo *.tsbuildinfo",
    "build:poc": "tsc -p tsconfig.poc.json",
    "poc:serve": "yarn build:poc && node dist-poc/poc/poc1.js",
    "poc:measure": "yarn build:poc && node dist-poc/poc/measure.js"
  },
  "dependencies": {
    "@testflow/contracts": "workspace:^",
    "@testflow/db": "workspace:^",
    "bullmq": "6.3.6",
    "ioredis": "6.0.0",
    "mysql2": "3.24.4",
    "playwright": "1.63.0",
    "reflect-metadata": "0.2.2",
    "typeorm": "1.1.1",
    "ws": "8.21.3"
  },
  "devDependencies": {
    "@testflow/config-eslint": "workspace:^",
    "@testflow/config-typescript": "workspace:^",
    "@types/node": "22.20.3",
    "@types/ws": "8.18.1",
    "eslint": "10.10.0",
    "typescript": "6.0.3",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  }
}
