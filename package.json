{
  "name": "testflow",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "clean": "turbo run clean && rm -rf node_modules",
    "db:migrate": "pnpm --filter @testflow/db migration:run",
    "db:revert": "pnpm --filter @testflow/db migration:revert"
  },
  "devDependencies": {
    "@testflow/config-eslint": "workspace:*",
    "@testflow/config-typescript": "workspace:*",
    "eslint": "10.10.0",
    "prettier": "3.9.6",
    "turbo": "2.10.13",
    "typescript": "6.0.3"
  }
}
